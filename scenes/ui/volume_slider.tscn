script = ExtResource("1_script")

[node name="MusicRow" parent="." instance=ExtResource("2_row")]
layout_mode = 2
channel = "music"

[node name="SfxRow" parent="." instance=ExtResource("2_row")]
layout_mode = 2
channel = "sfx"
