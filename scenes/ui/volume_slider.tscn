[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/volume_slider.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/volume_row.tscn" id="2_row"]

[node name="VolumeSlider" type="VBoxContainer"]
